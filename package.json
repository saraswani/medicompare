{
  "name": "medicompare",
  "version": "1.0.0",
  "description": "Indian Medicine Price Comparison and Generic Alternative Finder App",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm --prefix server install && npm --prefix client install && npm --prefix client run build && npm run seed",
    "seed": "node server/scripts/build_full_dataset.js",
    "seed:download": "node server/scripts/download_full_dataset.js",
    "test": "node server/scripts/test_integration.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
