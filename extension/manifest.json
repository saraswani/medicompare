{
  "manifest_version": 3,
  "name": "ValueBuy — Indian Medicine Generic Finder",
  "version": "1.0.0",
  "description": "Instantly compare medicine prices and find bio-equivalent Jan Aushadhi generic alternatives on 1mg, Apollo, Netmeds, and PharmEasy.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.1mg.com/*",
    "https://*.apollopharmacy.in/*",
    "https://*.netmeds.com/*",
    "https://*.pharmeasy.in/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.1mg.com/*",
        "https://*.apollopharmacy.in/*",
        "https://*.netmeds.com/*",
        "https://*.pharmeasy.in/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
